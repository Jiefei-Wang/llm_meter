<Window x:Class="LLMMeter.UI.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Meter settings" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <StackPanel Margin="14">
        <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="Discovery (local only — never scans the LAN)" FontWeight="SemiBold" FontSize="11.5"/>
        <CheckBox x:Name="DiscoveryCheck" Content="Enable automatic discovery" Margin="4,6,0,2"/>
        <CheckBox x:Name="ListenerCheck" Content="Windows listening processes" Margin="18,2,0,2"/>
        <CheckBox x:Name="WslCheck" Content="WSL running distributions" Margin="18,2,0,6"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Rescan now" Padding="8,3" Click="OnRescanNow"/>
        </StackPanel>

        <Separator Margin="0,10"/>

        <TextBlock Text="Manual backends" FontWeight="SemiBold" FontSize="11.5"/>
        <ItemsControl x:Name="ManualList" MaxHeight="110" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Margin="4,6,0,4"/>

        <Separator Margin="0,6,0,10"/>

        <TextBlock Text="Widgets" FontWeight="SemiBold" FontSize="11.5"/>
        <CheckBox x:Name="TopmostCheck" Content="New widgets always stay in front (topmost)"
                  Margin="4,6,0,6"/>

        <Separator Margin="0,6,0,10"/>

        <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="11.5"/>
        <CheckBox x:Name="LoggingCheck" Content="Write LLMMeter.log beside the EXE (size-capped)"
                  Margin="4,6,0,4"/>

        <TextBlock Text="Configuration file:" FontSize="11" Foreground="{DynamicResource DimBrush}" Margin="4,6,0,2"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open folder" Padding="8,2" Margin="8,0,0,0" Click="OnOpenFolder"/>
            <TextBlock x:Name="ConfigPathText" FontSize="11" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Width="72" Padding="4,3" IsDefault="True" Click="OnSave" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="72" Padding="4,3" IsCancel="True" Click="OnCancel"/>
        </StackPanel>

        <TextBlock FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="Privacy: LLM Meter reads server metrics endpoints and slot metadata only. It never stores prompt or completion text, never uploads telemetry, and works fully offline."/>
    </StackPanel>
</Window>
