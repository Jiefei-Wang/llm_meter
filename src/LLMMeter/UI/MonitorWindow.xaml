<Window x:Class="LLMMeter.UI.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        MinWidth="220" MaxWidth="520"
        ContextMenuOpening="OnContextMenuOpening"
        Title="LLM Meter">
    <Window.LayoutTransform>
        <ScaleTransform x:Name="RootScale"/>
    </Window.LayoutTransform>

    <Border x:Name="RootBorder" CornerRadius="8" Margin="10"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="9" ShadowDepth="1.5" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="10,7,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" x:Name="StatusDot" Width="9" Height="9"
                         Fill="{DynamicResource OfflineBrush}" VerticalAlignment="Center"
                         Margin="0,0,6,1"/>

                <Button x:Name="SelectorButton" Grid.Column="1" Style="{StaticResource GlyphButton}"
                        HorizontalAlignment="Left" Click="OnOpenSelector" ToolTip="Choose backend">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderText" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgBrush}"
                                   Text="LLM Meter"/>
                        <TextBlock Text=" ▾" FontFamily="Segoe UI" FontSize="10.5"
                                   Foreground="{DynamicResource DimBrush}" Margin="2,1,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="InfoButton" Style="{StaticResource GlyphButton}" Content="ⓘ"
                            FontFamily="Segoe UI" Visibility="Collapsed"
                            Click="OnShowHelp" ToolTip="Why is telemetry limited?"/>
                    <Button x:Name="AddWindowButton" Style="{StaticResource GlyphButton}" Content="＋"
                            Click="OnNewWindow" ToolTip="New monitor window (Ctrl+N)"/>
                    <Button x:Name="ExpandButton" Style="{StaticResource GlyphButton}" Content="︾"
                            Click="OnToggleExpand" ToolTip="Expand details"/>
                    <Button x:Name="CloseButton" Style="{StaticResource GlyphButton}" Content="✕"
                            Click="OnCloseWidget" ToolTip="Close this widget"/>
                </StackPanel>
            </Grid>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" x:Name="SubtitleText" Style="{StaticResource DimText}"
                       Margin="15,1,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="select a backend"/>

            <!-- Metrics -->
            <Grid Grid.Row="2" x:Name="MetricsGrid" Margin="2,3,2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Running"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RunningValue" Style="{StaticResource MetricValue}" Text="{Binding RunningText}" ToolTip="{Binding RunningToolTip}" MinWidth="34"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricLabel}" Text="Generated"/>
                <TextBlock Grid.Row="0" Grid.Column="4" x:Name="QueueValue" Style="{StaticResource MetricValue}" Text="{Binding GeneratedText}" ToolTip="{Binding GeneratedToolTip}" MinWidth="34"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Prefill"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PrefillValue" Style="{StaticResource MetricValue}" Text="{Binding PrefillText}" MinWidth="52"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricLabel}" Text="Generate"/>
                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="GenerateValue" Style="{StaticResource MetricValue}" Text="{Binding GenerateText}" MinWidth="52"/>
            </Grid>

            <!-- Expanded: separator -->
            <Separator Grid.Row="3" x:Name="RequestsSeparator" Background="{DynamicResource SeparatorBrush}"
                       Margin="0,5,0,3" Visibility="Collapsed"/>

            <!-- Expanded: requests -->
            <StackPanel Grid.Row="4" x:Name="RequestsPanel" Visibility="Collapsed">
                <ItemsControl x:Name="RequestList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" FontFamily="Consolas"
                                       Foreground="{DynamicResource FgBrush}"
                                       Text="{Binding Line}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MoreRequestsText" Style="{StaticResource DimText}" FontSize="10.5"/>
                <TextBlock x:Name="ModelsText" Style="{StaticResource DimText}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Expanded: bottom stats -->
            <Grid Grid.Row="5" x:Name="BottomStats" Margin="2,3,2,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MetricLabel}" Text="TTFT₁₀"/>
                <TextBlock Grid.Column="1" x:Name="TtftValue" Style="{StaticResource MetricValue}"
                           HorizontalAlignment="Left" Margin="6,0,0,0" Text="{Binding TtftText}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource MetricLabel}" Text="KV"/>
                <TextBlock Grid.Column="3" x:Name="KvValue" Style="{StaticResource MetricValue}" Text="{Binding KvText}" MinWidth="30"/>
            </Grid>
        </Grid>
    </Border>
</Window>
